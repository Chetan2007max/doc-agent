# MySQL (create first:  CREATE DATABASE docagent;)
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/docagent
# Quick local alternative:
# DATABASE_URL=sqlite:///./docagent.db

# auto = Gemini if key present, else rule-based extractor
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

TOLERANCE_PCT=1.0
MAX_LLM_RETRIES=2
